rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PROSPECTFLOW SECURITY RULES - PROTOTYPING MODE
     * 
     * Estas reglas han sido ajustadas para permitir el funcionamiento del Panel de Administración
     * sin restricciones de propiedad para las operaciones de lectura, edición y borrado,
     * cumpliendo con la solicitud de un panel administrativo de acceso directo.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // --- Reglas para la colección 'leads' ---
    match /leads/{leadId} {
      
      // Permitimos lectura a cualquier usuario firmado para que el Panel Admin funcione
      allow list, get: if isSignedIn();

      // La creación requiere que el usuario esté firmado
      allow create: if isSignedIn();

      /**
       * Para el prototipo y el panel administrativo:
       * Permitimos actualizar y borrar si el usuario está firmado,
       * eliminando la restricción de salesRepUid para evitar errores de permisos en el Panel Admin.
       */
      allow update, delete: if isSignedIn();
    }

    // Colección de metadatos para roles (opcional para escalar en el futuro)
    match /roles_admin/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
  }
}