rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para la colección 'leads': lectura y escritura pública para el equipo comercial
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // Reglas para la colección 'crm_users': perfiles y sincronización de cuentas
    match /crm_users/{uid} {
      allow read, write: if true;
    }

    // Reglas para configuración global 'crm_settings' (pestañas y preferencias de CRM)
    match /crm_settings/{docId} {
      allow read, write: if true;
    }

    // Reglas para WhatsApp Campaigns y Outbox de Tick Tool
    match /whatsapp_campaigns/{campaignId} {
      allow read, write: if true;
    }
    match /whatsapp_outbox/{outboxId} {
      allow read, write: if true;
    }

    // Reglas para Citas y Agenda comercial (FormDemo)
    match /citas_agenda/{citaId} {
      allow read, write: if true;
    }

    // Colección de metadatos para roles
    match /roles_admin/{uid} {
      allow read: if true;
      allow write: if false;
    }
  }
}
