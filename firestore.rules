rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PROSPECTFLOW SECURITY RULES - PROTOTYPING MODE
     * 
     * Estas reglas han sido ajustadas para permitir el funcionamiento del Panel de Administración
     * sin restricciones de propiedad para las operaciones de lectura, edición y borrado,
     * cumpliendo con la solicitud de un panel administrativo de acceso directo.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Reglas para la colección 'leads' ---
    match /leads/{leadId} {
      
      // Permitimos lectura a cualquier usuario firmado para que el Panel Admin funcione
      allow list, get: if isSignedIn();

      // La creación sigue requiriendo que se asigne el UID del usuario actual
      allow create: if isSignedIn() 
                    && request.resource.data.salesRepUid == request.auth.uid;

      /**
       * Para el prototipo y el panel administrativo solicitado:
       * Permitimos actualizar y borrar si el usuario está firmado.
       * Validamos que el 'salesRepUid' no sea modificado para mantener la integridad del registro original.
       */
      allow update: if isSignedIn()
                    && request.resource.data.salesRepUid == resource.data.salesRepUid;

      allow delete: if isSignedIn();
    }

    // Colección de metadatos para roles (opcional para escalar en el futuro)
    match /roles_admin/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }
  }
}