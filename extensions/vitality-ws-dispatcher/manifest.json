{
  "manifest_version": 3,
  "name": "Vitality Tick Tool - Royal Prestige WS Dispatcher",
  "short_name": "Vitality WS",
  "version": "1.0.0",
  "description": "Motor despachador ultra-liviano de campanas con archivos adjuntos, envios individuales con agenda de contactos y arboles de seguimiento en WhatsApp Web para Vitality Prospecc y Royal Prestige. Cero marcas de agua, jitter anti-baneo y parada automatica por respuesta.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://firestore.googleapis.com/*",
    "https://vitality-prospecc.web.app/*",
    "https://vitality-prospecc.firebaseapp.com/*",
    "https://studio-4949838222-b0ffc.web.app/*",
    "https://studio-4949838222-b0ffc.firebaseapp.com/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Vitality Tick Tool - Royal Prestige WS",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://vitality-prospecc.web.app/*",
        "https://vitality-prospecc.firebaseapp.com/*",
        "https://studio-4949838222-b0ffc.web.app/*",
        "https://studio-4949838222-b0ffc.firebaseapp.com/*",
        "http://localhost:*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
